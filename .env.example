# Configuracion compartida cliente/servidor
SERVER_HOST=127.0.0.1
SERVER_PORT=9999
TRANSPORT_MODE=TLS

# TLS (obligatorio)
TLS_CERT_FILE=config/tls/server.crt
TLS_KEY_FILE=config/tls/server.key
TLS_CA_FILE=config/tls/ca.crt
TLS_SERVER_HOSTNAME=localhost
TLS_MIN_VERSION=1.3

# Logging
LOG_LEVEL=INFO
